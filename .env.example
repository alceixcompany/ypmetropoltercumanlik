# --- Google Indexing API ---
# Yöntem 1 (önerilen, sunucuda): anahtar dosyası
GOOGLE_INDEXING_KEY_FILE=secrets/google-indexing-key.json
# Yöntem 2 (Vercel vb. dosya yüklenemeyen yerler): env değişkenleri
# GOOGLE_INDEXING_CLIENT_EMAIL=efmbot@efmindexing.iam.gserviceaccount.com
# GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Yöntem 3: JSON anahtarın base64 hali
# GOOGLE_INDEXING_CREDENTIALS_BASE64=
# CLI / cron ile /api/indexing çağırmak için gizli anahtar (x-indexing-secret başlığı)
INDEXING_API_SECRET=buraya-uzun-rastgele-bir-deger
